# Server
PORT=8080
LOG_LEVEL=info

# Postgres / Supabase
# User-context pool — connect as a role that respects RLS (e.g. `authenticator`).
# Recommended: use the Supabase connection pooler in transaction mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Service-role pool — bypasses RLS. ONLY consumed by the notification worker
# and the narrow token-gated state transitions in subscribers.
DATABASE_URL_SERVICE_ROLE=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Per-pool max connections. Keep this conservative; the worker has its own pool
# and Supabase has hard connection caps per project.
POOL_MAX_CONNS=10

# Supabase Auth (set exactly ONE of JWT_SECRET or JWKS_URL — both is rejected)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_JWT_SECRET=replace-with-the-supabase-jwt-secret
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/keys

# Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_ADDRESS=Fund the Future <hello@fundthefuture.org>

# App
APP_BASE_URL=https://api.fundthefuture.org

# Tokens — 32+ random bytes (base64 or hex). Used for HMAC signing of
# confirm/unsubscribe URLs.
TOKEN_SIGNING_KEY=replace-with-32-plus-random-bytes-xxxxxxxxxx

# Email hash key — 32+ random bytes. Used as the HMAC key for hashing
# email addresses in logs and email_log. Rotating this key invalidates
# the ability to correlate old hashes with new emails — by design.
EMAIL_HASH_KEY=replace-with-32-plus-random-bytes-yyyyyyyyyy

# CORS — explicit allowlist, NEVER '*'
ALLOWED_ORIGINS=https://fundthefuture.org,https://www.fundthefuture.org

# Trusted reverse-proxy CIDRs (comma-separated). Leave empty to ignore
# X-Forwarded-For entirely. Set to your edge CIDRs (Cloudflare, ALB, etc.)
# to make rate-limit and access-log IPs correct behind a proxy.
TRUSTED_PROXY_CIDRS=

# Rate limits (per IP per minute)
RATE_LIMIT_SUBSCRIBERS_PER_MIN=10
RATE_LIMIT_CONFIRM_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=60

# Notification worker
WORKER_CONCURRENCY=2
OUTBOUND_EMAIL_RPS=5
# Global daily cap on sends. The worker checks `sent` count in the last 24h
# before claiming work and refuses to dispatch above this cap.
MAX_DAILY_EMAILS=5000

# Re-subscribe throttle. If a confirm/notification was created for an email
# within this window, skip enqueueing a second one. Helps prevent attackers
# from using subscribe to email-bomb a third party.
SUBSCRIBE_EMAIL_THROTTLE_SEC=600

# Unsubscribe-token TTL in days. 1 year = links in old emails keep working;
# bounded so a leaked token has finite blast radius.
UNSUBSCRIBE_TOKEN_TTL_DAYS=365
